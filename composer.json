{
    "name": "vzgcoders/pdf-converter",
    "description": "Converts images into a PDF with a page for each, in the order given, every page the size of its image, with no dependencies beyond GD and zlib.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "PdfConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PdfConverter\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/image-to-pdf"
    ],
    "scripts": {
        "cs": "php-cs-fixer fix",
        "test": "phpunit",
        "test-web": "node --test tests/web/image-to-pdf.test.mjs"
    },
    "config": {
        "sort-packages": true
    }
}
