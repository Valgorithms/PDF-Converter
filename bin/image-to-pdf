#!/usr/bin/env php
<?php

declare(strict_types=1);

// Converts images into a PDF with a page for each, every page the size of its image, and prints the PDF's path.
// Usage: php bin/image-to-pdf <image>... [output.pdf]
// Pages follow the order the images are given in. The argument ending in .pdf, if any, is where the PDF
// goes; without one, it is written beside the first image with a .pdf extension.

use PdfConverter\ImageToPdf;

require __DIR__.'/../src/ImageToPdf.php';

// GD holds four bytes per pixel, so a phone photo alone can pass PHP's default 128 MB.
ini_set('memory_limit', '-1');

$arguments = array_slice($argv, 1);
$outputs = array_values(array_filter($arguments, static fn (string $a) => 1 === preg_match('/\.pdf$/i', $a)));
$imagePaths = array_values(array_diff($arguments, $outputs));

if ([] === $imagePaths || count($outputs) > 1) {
    fwrite(STDERR, "Usage: php bin/image-to-pdf <image>... [output.pdf]\n");

    exit(1);
}

$pdfPath = $outputs[0] ?? preg_replace('/\.[^.\\\\\/]*$/', '', $imagePaths[0]).'.pdf';

try {
    echo ImageToPdf::convertAll($imagePaths, $pdfPath), PHP_EOL;
} catch (\RuntimeException|\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage().PHP_EOL);

    exit(1);
}
